# Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon/publishable key (safe for browser code)
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Public URL where the app is hosted (used for auth redirects)
VITE_APP_URL=https://YOUR_GITHUB_USERNAME.github.io/YOUR_REPOSITORY/

# Optional: n8n public webhook URL (only for non-sensitive notifications)
VITE_N8N_PUBLIC_WEBHOOK_URL=
